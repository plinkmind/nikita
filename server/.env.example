# Copy to .env (never commit the real one) or set these as environment variables on your host.
# --- required for AI photo try-on ---
GCP_PROJECT=your-google-cloud-project-id
# Either paste a service-account key JSON on ONE line, or (on Google Cloud Run) leave it empty and give the Cloud Run service account the "Vertex AI User" role.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The website addresses allowed to call this server (comma separated, no trailing slash)
ALLOWED_ORIGINS=https://glamify-xr.netlify.app,http://localhost:5173
# --- optional ---
TRYON_MODEL=virtual-try-on-001
TRYON_LOCATION=us-central1
HAIR_MODEL=gemini-2.5-flash-image
HAIR_LOCATION=global
MAX_CONCURRENT=3
RATE_MAX=6
RATE_WINDOW_MS=600000
PORT=8080
