# Glamify XR AI server settings. Copy to .env (or set these in your hosting dashboard). NEVER put these in the website build.
PORT=8080
# the website(s) allowed to call this server, comma separated
ALLOWED_ORIGINS=https://your-site.netlify.app

# ---- Outfit try-on provider: "google" (Vertex AI Virtual Try-On) or "fashn" (FASHN tryon-v1.6) ----
TRYON_PROVIDER=fashn
# FASHN (https://app.fashn.ai -> API keys). Paid per generated image.
FASHN_API_KEY=
# quality | balanced | performance  (quality ~12-17 s, balanced ~8 s, performance ~5 s per image, per FASHN docs)
FASHN_MODE=quality

# ---- Google Cloud (needed for AI hairstyles; also for outfits when TRYON_PROVIDER=google) ----
GCP_PROJECT=
# the whole service-account JSON on one line (role: Vertex AI User). On Cloud Run you can omit it and use the service identity.
GOOGLE_SERVICE_ACCOUNT_JSON=
# HAIR_MODEL=gemini-2.5-flash-image
# TRYON_MODEL=virtual-try-on-001

# limits
RATE_MAX=6
RATE_WINDOW_MS=600000
MAX_CONCURRENT=3
